    for lesson in u['lessons']:
        spec=insertions.get(lesson['number'])
        if not spec: continue
        en_fig,ta_fig,en_title,ta_title,en_cap,ta_cap=spec
        for lang,fig,title_text,cap in [('english',en_fig,en_title,en_cap),('tamil',ta_fig,ta_title,ta_cap)]:
            blocks=lesson[lang]
            # Idempotent: remove earlier copy if script reruns.
            blocks[:]=[b for b in blocks if not (b.get('kind')=='svg_figure' and b.get('figure')==fig)]
            block={'kind':'svg_figure','title':title_text,'text':'','items':[],'rows':[],'figure':fig,'caption':cap}
            idx=next((i for i,b in enumerate(blocks) if b.get('kind') in ('explanation','explain')),1)
            blocks.insert(idx+1,block)

BOOK.write_text(json.dumps(book,ensure_ascii=False,indent=2),encoding='utf-8')

