def diagram_biodiversity(labels):
    center,*drivers=labels
    s=svg_head(center)+title(center)
    cx,cy=500,330
    s+=f'<circle cx="{cx}" cy="{cy}" r="120" fill="#E8F5E9" stroke="{INK}" stroke-width="4"/>\n'+text(cx,cy+10,center,'t')
    coords=[(500,110),(180,225),(820,225),(245,500),(755,500)]
    fills=['#FFF3E0','#FFEBEE','#E3F2FD','#F3E5F5','#E0F2F1']
    for (x,y),lab,fill in zip(coords,drivers,fills):
        w=250; h=80
        s+=box(x-w/2,y-h/2,w,h,lab,fill,'small')
        s+=arrow(x if abs(x-cx)<10 else (x+(w/2 if x<cx else -w/2)), y+(h/2 if y<cy else -h/2), cx+(0 if abs(x-cx)<10 else (-120 if x>cx else 120)), cy+(-110 if y<cy else 110))
    return s+footer()


