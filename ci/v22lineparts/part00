def esc(s:str)->str:
    return (s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('"','&quot;'))


def svg_head(title):
    return f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 620" role="img" aria-label="{esc(title)}">
<defs>
  <marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L9,3 z" fill="{INK}"/></marker>
  <style>
    .t{{font-family:sans-serif;fill:{INK};font-size:42px;font-weight:700}}
    .s{{font-family:sans-serif;fill:{INK};font-size:34px}}
    .small{{font-family:sans-serif;fill:{INK};font-size:30px}}
    .box{{rx:26;ry:26;stroke:{INK};stroke-width:3}}
    .arr{{stroke:{INK};stroke-width:5;fill:none;marker-end:url(#arrow);stroke-linecap:round}}
    .line{{stroke:{INK};stroke-width:4;fill:none;stroke-linecap:round}}
  </style>
</defs>
<rect width="1000" height="620" fill="{BG}"/>
'''


def footer(): return '</svg>\n'

def text(x,y,s,cls='s',anchor='middle'):
    return f'<text x="{x}" y="{y}" text-anchor="{anchor}" class="{cls}">{esc(s)}</text>\n'

def wrap_label(label, max_chars=18, max_lines=3):
    words=label.split()
    if not words: return ['']
    lines=[]; cur=''
    for word in words:
        candidate=(cur+' '+word).strip()
        if cur and len(candidate)>max_chars:
            lines.append(cur); cur=word
        else:
            cur=candidate
    if cur: lines.append(cur)
    if len(lines)>max_lines:
        lines=lines[:max_lines-1]+[' '.join(lines[max_lines-1:])]
    return lines

def box(x,y,w,h,label,fill=LIGHT,cls='s'):
    lines=wrap_label(label, 19 if cls=='small' else 16, 3)
    line_h=33 if cls=='small' else 37
    start=y+h/2-(len(lines)-1)*line_h/2+10
    out=f'<rect x="{x}" y="{y}" width="{w}" height="{h}" class="box" fill="{fill}"/>\n'
    for i,ln in enumerate(lines):
        out+=text(x+w/2,start+i*line_h,ln,cls)
    return out

def arrow(x1,y1,x2,y2): return f'<path d="M{x1} {y1} L{x2} {y2}" class="arr"/>\n'

def line(x1,y1,x2,y2): return f'<path d="M{x1} {y1} L{x2} {y2}" class="line"/>\n'

def title(s): return text(500,55,s,'t')


