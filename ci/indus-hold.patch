+
+private fun openPrivacyPolicyUrl(context: Context, url: String) {
+    val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url)).apply {
+        addCategory(Intent.CATEGORY_BROWSABLE)
+    }
+    if (runCatching { context.startActivity(intent) }.isSuccess) return
+
+    val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as? ClipboardManager
+    clipboard?.setPrimaryClip(ClipData.newPlainText("Environmental Studies Privacy Policy", url))
+    Toast.makeText(context, "Could not open the browser. Privacy Policy URL copied.", Toast.LENGTH_LONG).show()
+}
