        nx,ny=coords[(i+1)%len(coords)]
        s+=arrow(x+(70 if nx>x else -70 if nx<x else 0),y+(30 if ny>y else -30 if ny<y else 0),nx+(-70 if nx>x else 70 if nx<x else 0),ny+(-30 if ny>y else 30 if ny<y else 0))
    return s+footer()


def diagram_timeline(title_text, entries):
    s=svg_head(title_text)+title(title_text)
    s+=line(100,300,900,300)
    xs=[130,315,500,685,870]
    for x,(year,label),fill in zip(xs,entries,['#E3F2FD','#E8F5E9','#FFF3E0','#F3E5F5','#E0F2F1']):
        s+=f'<circle cx="{x}" cy="300" r="16" fill="{PRIMARY}"/>\n'
        s+=text(x,245,year,'t')
        s+=box(x-82,345,164,90,label,fill,'small')
    return s+footer()

def diagram_audit(title_text, labels):
    s=svg_head(title_text)+title(title_text)
    top=[(70,170),(390,170),(710,170)]
    fills=['#E3F2FD','#E8F5E9','#FFF3E0']
    for (x,y),lab,fill in zip(top,labels[:3],fills):
        s+=box(x,y,220,100,lab,fill,'small')
    s+=arrow(290,220,390,220)+arrow(610,220,710,220)
    s+=arrow(820,270,820,365)
    s+=box(550,365,270,105,labels[3],'#E0F2F1','small')
    s+=arrow(550,418,440,418)
    s+=box(170,365,270,105,labels[4],'#F3E5F5','small')
    return s+footer()

