def normalize_text(s):
    if not isinstance(s,str):
        return s
    for old,new in PREFIX_REPLACEMENTS.items():
        if s.startswith(old):
            s=new+s[len(old):]
    for old,new in PHRASE_REPLACEMENTS.items():
        s=s.replace(old,new)
    return s

for unit in data['units']:
    unit['titleTa']=normalize_text(unit.get('titleTa',''))
    for l in unit['lessons']:
        l['titleTa']=normalize_text(l.get('titleTa',''))
        for b in l['tamil']:
            if b.get('title')=='மேலும் ஆழமாக':
                b['title']='விரிவான விளக்கம்'
            elif b.get('title')=='தமிழ்நாடு தொடர்பு':
                b['title']='தமிழ்நாடு எடுத்துக்காட்டு'
            else:
                if isinstance(b.get('title'),str): b['title']=normalize_text(b['title'])
            for key in ('text','caption'):
                if isinstance(b.get(key),str): b[key]=normalize_text(b[key])
            if isinstance(b.get('items'),list):
                b['items']=[normalize_text(v) if isinstance(v,str) else v for v in b['items']]
            if isinstance(b.get('rows'),list):
                b['rows']=[[normalize_text(v) if isinstance(v,str) else v for v in row] for row in b['rows']]

