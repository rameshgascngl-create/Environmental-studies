# Collect visible Tamil strings.
def visible_strings():
    for u in data['units']:
        yield u.get('titleTa','')
        for l in u['lessons']:
            yield l.get('titleTa','')
            for b in l['tamil']:
                for k in ('title','text','caption'):
                    if isinstance(b.get(k),str): yield b[k]
                for x in b.get('items') or []:
                    if isinstance(x,str): yield x
                for row in b.get('rows') or []:
                    for x in row:
                        if isinstance(x,str): yield x
corpus='\n'.join(visible_strings())
